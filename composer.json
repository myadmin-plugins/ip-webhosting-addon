{
	"name": "detain/myadmin-ip-webhosting-addon",
	"type": "myadmin-plugin",
	"description": "Dedicated IP Addon for Webhosting Module in MyAdmin",
	"keywords": [
		"ip",
		"administration",
		"webhosting",
		"dedicated ip",
		"myadmin",
		"plugin",
		"addon"
	],
	"license": "LGPL-2.1-only",
	"authors": [
		{
			"name": "Joe Huss",
			"homepage": "https:\/\/my.interserver.net\/"
		}
	],
	"config": {
		"bin-dir": "vendor\/bin",
		"minimum-stability": "dev",
		"allow-plugins": {
			"detain/myadmin-plugin-installer": true
		}
	},
	"require": {
		"php": ">=5.0.0",
		"ext-soap": "*",
		"symfony/event-dispatcher": "*@stable",
		"detain/myadmin-plugin-installer": "^2.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6"
	},
	"repositories": [
		{
			"type": "package",
			"package": {
				"name": "cpanelinc/xmlapi-php",
				"version": "2.0.1",
				"source": {
					"url": "https://github.com/CpanelInc/xmlapi-php.git",
					"type": "git",
					"reference": "master"
				}
			}
		}
	],
	"autoload": {
		"psr-4": {
			"Detain\\MyAdminWebhostingIp\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Detain\\MyAdminWebhostingIp\\Tests\\": "tests/"
		}
	}
}
